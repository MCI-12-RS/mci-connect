-- E2.06 (PR 1): volume de referência e metas do risco 6 (tempo da RN-08).
-- Spec: docs/specs/e2-06-hierarquia-totais.md (repositório apps-mci), Riscos, item 6:
-- 20 mil membros com profundidade até 10 e 1.500 células, medidos no banco.
--
-- Metas (ms):
--   gravação comum (situação, sexo, cadastro de membro ou de célula) ......... 50
--   troca de líder de quem tem cerca de 100 abaixo ........................... 100
--   troca de líder de um G12 com cerca de 2 mil abaixo ....................... 1000
--   pastor que ganha líder (cerca de 20 mil abaixo) .......................... 4000
--   rebuild_member_hierarchy() (do zero, 20 mil linhas) ...................... 5000
--   página com contagem da members_view e da cells_view ...................... 300
--   ministry_tree_nodes com 100 ids .......................................... 50
--   dashboard_g12_ranking .................................................... 800
--
-- Árvore: 2 pastores casados (1 e 2), 10 G12 (3 a 12) sob o pastor 1 e, abaixo de cada G12, um heap
-- ternário de cerca de 2 mil pessoas (profundidade até 9), mais uma cadeia que leva a profundidade a 10.
-- O membro 2 é Administrador (vê a igreja toda); o membro 3, G12 com função Líder (vê o ministério).
-- 1.500 células com líder espalhado, 10% dos membros inativos.
--
-- Roda numa transação desfeita no fim (nada fica no banco). Uso (banco local):
--   docker exec -i supabase_db_<projeto> psql -U postgres -X -v ON_ERROR_STOP=1 \
--     < supabase/tests/volume/e206_volume.psql > e206_explain.txt
-- A saída traz o EXPLAIN (ANALYZE, BUFFERS) de cada operação e uma linha "META" por medida, com o
-- tempo (o melhor de algumas rodadas, cada uma desfeita) e o limite.

\set ON_ERROR_STOP on
\timing off
BEGIN;
SET LOCAL session_replication_role = replica;      -- carga: sem triggers, como a do legado
SET LOCAL synchronous_commit = off;

INSERT INTO auth.users (id, email)
SELECT ('a2060900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid, 'e206-vol-' || n || '@teste.invalid' FROM generate_series(1, 3) n;

CREATE FUNCTION pg_temp.mid(_n int) RETURNS uuid LANGUAGE sql IMMUTABLE AS
$$ SELECT ('c2060900-0000-0000-0000-' || lpad(_n::text, 12, '0'))::uuid $$;
-- Líder do membro n: pastores 1 e 2 sem líder; G12 3..12 sob o pastor 1; os demais num heap ternário
-- por G12 (k = n - 13; g = k % 10 é o G12; j = k / 10 a posição no heap); 19999 e 20000 formam a cadeia
-- que fecha o nível 10.
CREATE FUNCTION pg_temp.leader_of(_n int) RETURNS int LANGUAGE sql IMMUTABLE AS $$
  SELECT CASE WHEN _n <= 2 THEN NULL
              WHEN _n <= 12 THEN 1
              WHEN _n = 19999 THEN 13 + 500 * 10
              WHEN _n = 20000 THEN 19999
              WHEN (_n - 13) / 10 = 0 THEN 3 + (_n - 13) % 10
              ELSE 13 + (((_n - 13) / 10 - 1) / 3) * 10 + (_n - 13) % 10 END $$;

INSERT INTO public.members (id, name, gender, is_pastor, leader_id, spouse_id, is_active, has_leadership, auth_user_id, role_id, created_at, mobile_whatsapp)
SELECT pg_temp.mid(n),
       'Membro Volume ' || n,
       CASE WHEN n % 2 = 0 THEN 'F' ELSE 'M' END,
       n <= 2,
       pg_temp.mid(pg_temp.leader_of(n)),
       CASE WHEN n = 1 THEN pg_temp.mid(2) WHEN n = 2 THEN pg_temp.mid(1)
            WHEN n BETWEEN 13 AND 1012 THEN pg_temp.mid(n + 5000)
            WHEN n BETWEEN 5013 AND 6012 THEN pg_temp.mid(n - 5000) END,
       n % 10 <> 0 OR n <= 12,
       n > 2,
       CASE n WHEN 2 THEN 'a2060900-0000-0000-0000-000000000002'::uuid WHEN 3 THEN 'a2060900-0000-0000-0000-000000000003'::uuid END,
       CASE WHEN n = 2 THEN (SELECT id FROM public.roles WHERE name = 'Administrador')
            WHEN n = 3 THEN (SELECT id FROM public.roles WHERE name = 'Líder') END,
       now() - (n % 400) * interval '1 day',
       '519' || lpad(n::text, 8, '0')
  FROM generate_series(1, 20000) n;
-- 1.500 células com líder, timóteo e anfitrião espalhados pela árvore (as do líder 13..19988).
INSERT INTO public.cells (id, leader_id, timothy_id, host_id, type, meeting_day, meeting_time, street, neighborhood, city, is_active)
SELECT ('d2060900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid,
       pg_temp.mid(13 + (n * 13) % 19980), pg_temp.mid(13 + (n * 17) % 19980), pg_temp.mid(13 + (n * 19) % 19980),
       (ARRAY['Evangelística', 'Discipulado', 'Macrocélula'])[1 + n % 3],
       (ARRAY['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'])[1 + n % 7],
       '20:00', 'Rua ' || n, 'Bairro ' || (n % 40), 'Porto Alegre', n % 10 <> 0
  FROM generate_series(1, 1500) n;
SET LOCAL session_replication_role = origin;
ANALYZE public.members; ANALYZE public.cells;

\echo '######## CARGA E RECÁLCULO ########'
SELECT 'VOLUME members=' || (SELECT count(*) FROM public.members) || ' cells=' || (SELECT count(*) FROM public.cells) AS volume;
CREATE FUNCTION pg_temp.timed(_sql text) RETURNS numeric LANGUAGE plpgsql AS $$
DECLARE _t timestamptz := clock_timestamp();
BEGIN EXECUTE _sql; RETURN round(extract(epoch FROM clock_timestamp() - _t) * 1000, 1); END $$;
EXPLAIN (ANALYZE, BUFFERS) SELECT private.rebuild_member_hierarchy();
-- Do zero de verdade (a EXPLAIN acima já criou as linhas): esvazia e roda de novo.
TRUNCATE private.member_hierarchy;
SELECT 'META rebuild_member_hierarchy() do zero, 20 mil linhas (ms, meta 5000)', pg_temp.timed('SELECT private.rebuild_member_hierarchy()') AS ms;
SELECT 'META rebuild_member_hierarchy() de novo, sem nada a mudar (ms)', pg_temp.timed('SELECT private.rebuild_member_hierarchy()') AS ms;
SELECT 'CONFERÊNCIA drift depois do recálculo (linhas, esperado 0)', count(*) AS n FROM private.member_hierarchy_drift();
ANALYZE private.member_hierarchy;
SELECT 'PROFUNDIDADE máxima=' || max(g12_level) || ', G12 com mais gente abaixo=' || (SELECT max(c) FROM (SELECT count(*) c FROM private.member_hierarchy x WHERE x.g12_level >= 2 GROUP BY x.ancestor_ids[2]) q) AS depth
  FROM private.member_hierarchy;

-- Escolhas: o G12 com cerca de 2 mil abaixo, quem tem cerca de 100 abaixo, folhas e um nó fundo.
SELECT member_id AS big_g12 FROM private.member_hierarchy h
 WHERE g12_level = 1 AND member_id NOT IN (pg_temp.mid(3), pg_temp.mid(5))
 ORDER BY abs((SELECT count(*) FROM private.member_hierarchy x WHERE x.ancestor_ids @> ARRAY[h.member_id]) - 2000), member_id LIMIT 1 \gset
SELECT member_id AS mid100 FROM private.member_hierarchy h
 WHERE g12_level >= 3 AND ancestor_ids[2] = pg_temp.mid(4) AND NOT member_id = pg_temp.mid(19999)
 ORDER BY abs((SELECT count(*) FROM private.member_hierarchy x WHERE x.ancestor_ids @> ARRAY[h.member_id]) - 100), member_id LIMIT 1 \gset
SELECT 'ESCOLHA G12 com ' || (SELECT count(*) FROM private.member_hierarchy x WHERE x.ancestor_ids @> ARRAY[:'big_g12'::uuid]) || ' abaixo; membro com '
    || (SELECT count(*) FROM private.member_hierarchy x WHERE x.ancestor_ids @> ARRAY[:'mid100'::uuid]) || ' abaixo; pastor 1 com '
    || (SELECT count(*) FROM private.member_hierarchy x WHERE x.ancestor_ids @> ARRAY[pg_temp.mid(1)]) || ' abaixo' AS escolhas;
SELECT pg_temp.mid(13 + 3 + 3 * 3000) AS leaf \gset
SELECT id AS cell_any FROM public.cells WHERE is_active ORDER BY id LIMIT 1 \gset
SELECT leader_id AS cell_leader FROM public.cells WHERE id = :'cell_any' \gset
SELECT pg_temp.mid(2) AS admin_m, pg_temp.mid(1) AS pastor1, pg_temp.mid(4) AS g12_other, pg_temp.mid(5) AS big_to \gset

-- Tempo de uma gravação, em ms, como a pessoa n (2 = Administrador, 3 = G12): o melhor de _rounds, cada rodada desfeita.
CREATE FUNCTION pg_temp.undo_ms(_n int, _sql text, _rounds int DEFAULT 5) RETURNS numeric LANGUAGE plpgsql AS $$
DECLARE _t timestamptz; _best numeric := NULL; _x numeric; i int;
BEGIN
  FOR i IN 1.._rounds LOOP
    BEGIN
      PERFORM set_config('request.jwt.claims', json_build_object('sub', 'a2060900-0000-0000-0000-' || lpad(_n::text, 12, '0'), 'role', 'authenticated')::text, true);
      EXECUTE 'SET LOCAL ROLE authenticated';
      _t := clock_timestamp();
      EXECUTE _sql;
      _x := extract(epoch FROM clock_timestamp() - _t) * 1000;
      IF _best IS NULL OR _x < _best THEN _best := _x; END IF;
      RAISE EXCEPTION 'undo' USING ERRCODE = 'P0099';
    EXCEPTION WHEN SQLSTATE 'P0099' THEN NULL;
    END;
  END LOOP;
  RETURN round(_best, 1);
END $$;
-- Tempo de uma leitura, em ms (o melhor de _rounds), sob o papel e a sessão que o chamador já pôs.
CREATE FUNCTION pg_temp.ms(_sql text, _rounds int DEFAULT 5) RETURNS numeric LANGUAGE plpgsql AS $$
DECLARE _t timestamptz; _best numeric := NULL; _x numeric; i int;
BEGIN
  FOR i IN 1.._rounds LOOP
    _t := clock_timestamp();
    EXECUTE _sql;
    _x := extract(epoch FROM clock_timestamp() - _t) * 1000;
    IF _best IS NULL OR _x < _best THEN _best := _x; END IF;
  END LOOP;
  RETURN round(_best, 1);
END $$;
-- O plano de uma consulta cita _pat? (a junção nova das views tem de ser descartada na contagem)
CREATE FUNCTION pg_temp.plan_has(_sql text, _pat text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE _l text; _found boolean := false;
BEGIN
  FOR _l IN EXECUTE 'EXPLAIN ' || _sql LOOP
    IF _l LIKE '%' || _pat || '%' THEN _found := true; END IF;
  END LOOP;
  RETURN _found;
END $$;
CREATE FUNCTION pg_temp.as_member(_n int) RETURNS void LANGUAGE sql AS $$
  SELECT set_config('request.jwt.claims', json_build_object('sub', 'a2060900-0000-0000-0000-' || lpad(_n::text, 12, '0'), 'role', 'authenticated')::text, true) $$;

\echo
\echo '######## GRAVAÇÕES (como o Administrador, com todos os triggers) ########'
\set u_active 'UPDATE public.members SET is_active = false WHERE id = ':'leaf'
SAVEPOINT s; SELECT pg_temp.as_member(2); SET LOCAL ROLE authenticated;
\echo '--- inativar uma folha'
EXPLAIN (ANALYZE, BUFFERS) UPDATE public.members SET is_active = false WHERE id = :'leaf';
RESET ROLE; ROLLBACK TO s;
SELECT 'META gravação comum: inativar uma folha (ms, meta 50)', pg_temp.undo_ms(2, format('UPDATE public.members SET is_active = false WHERE id = %L', :'leaf')) AS ms;
SELECT 'META gravação comum: trocar o sexo de quem lidera uma célula (ms, meta 50)', pg_temp.undo_ms(2, format('UPDATE public.members SET gender = CASE gender WHEN $x$M$x$ THEN $x$F$x$ ELSE $x$M$x$ END WHERE id = %L', :'cell_leader')) AS ms;
SELECT 'META gravação comum: cadastro de membro sob uma folha, no nível 10 (ms, meta 50)',
  pg_temp.undo_ms(2, format($q$INSERT INTO public.members (name, gender, leader_id, has_leadership, mobile_whatsapp) VALUES ($x$Novo Volume$x$, $x$F$x$, %L, true, $x$51988880001$x$)$q$, pg_temp.mid(20000))) AS ms;
SELECT 'META gravação comum: cadastro de célula (ms, meta 50)',
  pg_temp.undo_ms(2, format($q$INSERT INTO public.cells (leader_id, timothy_id, host_id, type, meeting_day, meeting_time) VALUES (%L, %L, %L, $x$Evangelística$x$, $x$Quarta$x$, $x$20:00$x$)$q$, pg_temp.mid(20000), :'admin_m', :'admin_m')) AS ms;
SELECT 'META gravação comum: inativar uma célula (ms, meta 50)', pg_temp.undo_ms(2, format('UPDATE public.cells SET is_active = false WHERE id = %L', :'cell_any')) AS ms;
SELECT 'META gravação comum: o G12 (Líder) edita as observações de um membro dele (ms, meta 50)',
  pg_temp.undo_ms(3, format($q$UPDATE public.members SET notes = $x$editado$x$ WHERE id = %L$q$, :'leaf')) AS ms;

\echo '--- troca de líder de quem tem cerca de 100 abaixo (EXPLAIN)'
SAVEPOINT s; SELECT pg_temp.as_member(2); SET LOCAL ROLE authenticated;
EXPLAIN (ANALYZE, BUFFERS) UPDATE public.members SET leader_id = :'g12_other' WHERE id = :'mid100';
RESET ROLE; ROLLBACK TO s;
SELECT 'META troca de líder de quem tem ~100 abaixo (ms, meta 100)', pg_temp.undo_ms(2, format('UPDATE public.members SET leader_id = %L WHERE id = %L', :'g12_other', :'mid100')) AS ms;
\echo '--- troca de líder de um G12 com cerca de 2 mil abaixo, para outro G12 (EXPLAIN)'
SAVEPOINT s; SELECT pg_temp.as_member(2); SET LOCAL ROLE authenticated;
EXPLAIN (ANALYZE, BUFFERS) UPDATE public.members SET leader_id = :'big_to' WHERE id = :'big_g12';
RESET ROLE; ROLLBACK TO s;
SELECT 'META troca de líder de um G12 com ~2 mil abaixo (ms, meta 1000)', pg_temp.undo_ms(2, format('UPDATE public.members SET leader_id = %L WHERE id = %L', :'big_to', :'big_g12'), 3) AS ms;
\echo '--- pastor que ganha líder (cerca de 20 mil abaixo): o pastor 1 passa a discípulo do pastor 2 (EXPLAIN)'
SAVEPOINT s; SELECT pg_temp.as_member(2); SET LOCAL ROLE authenticated;
EXPLAIN (ANALYZE, BUFFERS) UPDATE public.members SET is_pastor = false, leader_id = :'admin_m', has_leadership = true WHERE id = :'pastor1';
RESET ROLE; ROLLBACK TO s;
SELECT 'META pastor que ganha líder, ~20 mil abaixo (ms, meta 4000)', pg_temp.undo_ms(2, format('UPDATE public.members SET is_pastor = false, leader_id = %L, has_leadership = true WHERE id = %L', :'admin_m', :'pastor1'), 3) AS ms;
SELECT 'CONFERÊNCIA drift depois das gravações desfeitas (linhas, esperado 0)', count(*) AS n FROM private.member_hierarchy_drift();

\echo
\echo '######## LEITURAS ########'
\set member_cols 'id, name, gender, birth_date, instagram, avatar_url, notes, neighborhood, city, state, is_pastor, has_leadership, leader_id, leader_name, spouse_id, is_baptized, baptism_date, is_active, g12_level, total_disciples, total_cells, role_id, auth_user_id, sensitive_visible, email, cpf, mobile_whatsapp, phone, street, number, complement, zip_code, g12_id, g12_name'
\set cell_cols 'id, leader_id, timothy_id, host_id, type, meeting_day, meeting_time, street, number, complement, neighborhood, city, state, zip_code, is_active, leader_name, leader_g12_level, timothy_name, host_name, g12_leader_name'
\echo '######## ADMINISTRADOR (igreja toda) ########'
SELECT pg_temp.as_member(2); SET LOCAL ROLE authenticated;
\echo '--- Lista de membros: página (25) e contagem'
SELECT format('EXPLAIN (ANALYZE, BUFFERS) SELECT %s FROM public.members_view ORDER BY name, id LIMIT 25', :'member_cols') \gexec
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.members_view;
\echo '--- Lista de células: página (25) e contagem'
SELECT format('EXPLAIN (ANALYZE, BUFFERS) SELECT %s FROM public.cells_view ORDER BY created_at DESC, id LIMIT 25', :'cell_cols') \gexec
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.cells_view;
SELECT 'META Administrador: página de membros + contagem (ms, meta 300)', pg_temp.ms(format('SELECT %s FROM public.members_view ORDER BY name, id LIMIT 25', :'member_cols')) + pg_temp.ms($q$SELECT count(*) FROM public.members_view$q$) AS ms;
SELECT 'META Administrador: página de células + contagem (ms, meta 300)', pg_temp.ms(format('SELECT %s FROM public.cells_view ORDER BY created_at DESC, id LIMIT 25', :'cell_cols')) + pg_temp.ms($q$SELECT count(*) FROM public.cells_view$q$) AS ms;
SELECT 'DIAG Administrador: o plano da contagem da members_view lê member_hierarchy? (esperado f: a junção é descartada)', pg_temp.plan_has('SELECT count(*) FROM public.members_view', 'member_hierarchy') AS le_hierarquia;
SELECT 'DIAG Administrador: o plano da contagem da cells_view lê member_hierarchy? (esperado f)', pg_temp.plan_has('SELECT count(*) FROM public.cells_view', 'member_hierarchy') AS le_hierarquia;
SELECT 'DIAG Administrador: o plano da página da members_view lê member_hierarchy? (esperado t: o nível e os totais vêm dela)', pg_temp.plan_has(format('SELECT %s FROM public.members_view ORDER BY name, id LIMIT 25', :'member_cols'), 'member_hierarchy') AS le_hierarquia;
SELECT 'META Administrador: contagem de membros sozinha (ms)', pg_temp.ms($q$SELECT count(*) FROM public.members_view$q$) AS ms;
SELECT 'META Administrador: contagem de células sozinha (ms)', pg_temp.ms($q$SELECT count(*) FROM public.cells_view$q$) AS ms;
\echo '--- dashboard_g12_ranking'
EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM public.dashboard_g12_ranking();
SELECT 'META Administrador: dashboard_g12_ranking (ms, meta 800)', pg_temp.ms($q$SELECT * FROM public.dashboard_g12_ranking()$q$) AS ms;
SELECT array_to_string(array_agg(quote_literal(id)), ',') AS ids100 FROM (SELECT id FROM public.members_view WHERE g12_level = 3 ORDER BY id LIMIT 100) q \gset
\echo '--- ministry_tree_nodes: raízes e 100 ids (o corpo da função inteiro)'
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.ministry_tree_nodes();
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.ministry_tree_nodes(ARRAY[:ids100]::uuid[]);
SELECT 'META Administrador: ministry_tree_nodes() raízes (ms)', pg_temp.ms($q$SELECT count(*) FROM public.ministry_tree_nodes()$q$) AS ms;
SELECT 'META Administrador: ministry_tree_nodes com 100 ids (ms, meta 50)', pg_temp.ms(format('SELECT count(*) FROM public.ministry_tree_nodes(ARRAY[%s]::uuid[])', :'ids100')) AS ms;
SELECT 'META Administrador: ministry_tree_nodes com 1 id (ms)', pg_temp.ms(format('SELECT count(*) FROM public.ministry_tree_nodes(ARRAY[%L]::uuid[])', :'big_g12')) AS ms;
\echo '--- DIAG: o custo só do _tree_roots (varre a members_view em toda chamada, não só na das raízes)'
EXPLAIN (ANALYZE, BUFFERS) SELECT ARRAY(SELECT mv.id FROM public.members_view mv WHERE mv.is_active AND mv.is_pastor);
SELECT 'DIAG Administrador: só o _tree_roots (pastores ativos pela members_view) (ms)', pg_temp.ms($q$SELECT ARRAY(SELECT mv.id FROM public.members_view mv WHERE mv.is_active AND mv.is_pastor)$q$) AS ms;
SELECT 'DIAG Administrador: ministry_tree_nodes com 100 ids menos o _tree_roots (ms, estimativa)',
  pg_temp.ms(format('SELECT count(*) FROM public.ministry_tree_nodes(ARRAY[%s]::uuid[])', :'ids100')) - pg_temp.ms($q$SELECT ARRAY(SELECT mv.id FROM public.members_view mv WHERE mv.is_active AND mv.is_pastor)$q$) AS ms;
RESET ROLE;

\echo
\echo '######## G12 (Líder, um ministério de cerca de 2 mil pessoas) ########'
SELECT pg_temp.as_member(3); SET LOCAL ROLE authenticated;
\echo '--- Lista de membros e de células: contagem'
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.members_view;
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.cells_view;
SELECT 'DIAG G12: o plano da contagem da members_view lê member_hierarchy? (esperado f)', pg_temp.plan_has('SELECT count(*) FROM public.members_view', 'member_hierarchy') AS le_hierarquia;
SELECT 'DIAG G12: o plano da contagem da cells_view lê member_hierarchy? (esperado f)', pg_temp.plan_has('SELECT count(*) FROM public.cells_view', 'member_hierarchy') AS le_hierarquia;
SELECT 'META G12: página de membros + contagem (ms, meta 300)', pg_temp.ms(format('SELECT %s FROM public.members_view ORDER BY name, id LIMIT 25', :'member_cols')) + pg_temp.ms($q$SELECT count(*) FROM public.members_view$q$) AS ms;
SELECT 'META G12: página de células + contagem (ms, meta 300)', pg_temp.ms(format('SELECT %s FROM public.cells_view ORDER BY created_at DESC, id LIMIT 25', :'cell_cols')) + pg_temp.ms($q$SELECT count(*) FROM public.cells_view$q$) AS ms;
SELECT array_to_string(array_agg(quote_literal(id)), ',') AS ids100g FROM (SELECT id FROM public.members_view WHERE g12_level = 3 ORDER BY id LIMIT 100) q \gset
EXPLAIN (ANALYZE, BUFFERS) SELECT count(*) FROM public.ministry_tree_nodes(ARRAY[:ids100g]::uuid[]);
SELECT 'META G12: ministry_tree_nodes com 100 ids (ms, meta 50)', pg_temp.ms(format('SELECT count(*) FROM public.ministry_tree_nodes(ARRAY[%s]::uuid[])', :'ids100g')) AS ms;
\echo '--- DIAG: o custo só do _tree_roots do G12 (viewer_tree_roots + members_view)'
EXPLAIN (ANALYZE, BUFFERS) SELECT ARRAY(SELECT mv.id FROM public.members_view mv WHERE mv.is_active AND mv.id = ANY (public.viewer_tree_roots()));
SELECT 'DIAG G12: só o _tree_roots (ms)', pg_temp.ms($q$SELECT ARRAY(SELECT mv.id FROM public.members_view mv WHERE mv.is_active AND mv.id = ANY (public.viewer_tree_roots()))$q$) AS ms;
SELECT 'META G12: ministry_tree_nodes() raízes (ms)', pg_temp.ms($q$SELECT count(*) FROM public.ministry_tree_nodes()$q$) AS ms;
SELECT 'META G12: dashboard_g12_ranking (ms, meta 800)', pg_temp.ms($q$SELECT * FROM public.dashboard_g12_ranking()$q$) AS ms;
RESET ROLE;
ROLLBACK;
