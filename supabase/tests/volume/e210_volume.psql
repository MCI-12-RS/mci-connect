-- E2.10 (PR 1): volume de referência e "Metas de tempo e índices".
-- Spec: docs/specs/e2-10-listagem-celulas.md (repositório apps-mci), "Metas de tempo e índices" e
-- "Verificações obrigatórias (para o QA)": 20 mil membros, 1.500 células, 100 mil relatórios com cerca de
-- 8 participantes cada (o volume do E1.08, do E2.06 e do E2.09) e uma célula com 400 relatórios.
--
-- Metas (mediana de 5 execuções):
--   - cells_list (25 linhas) e cells_list_count sem filtros: Administrador 150 ms cada; G12 100 ms cada;
--   - só "Situação do relatório: Pendente", Administrador: 300 ms cada;
--   - a combinação da RN-02: 1 s cada;
--   - cell_filter_options (Líder e G12, com e sem busca), Administrador: 100 ms;
--   - cell_filter_names com 10 ids: 50 ms;
--   - cells_view por id com as colunas do detalhe: 100 ms;
--   - cell_recent_reports na célula com 400 relatórios: 150 ms;
--   - cell_identity: 50 ms;
--   - cell_reports_view com cell_id (página e total): 150 ms.
-- Planos conferidos: a etapa 2 usa cells_pkey; sem o filtro de situação, a contagem não chama
-- private.cell_report_situation; o G12 e a data entram na view; cell_recent_reports usa um índice que
-- começa por cell_id (cell_reports_cell_id_date_idx ou cell_reports_cell_week_key) e a PK de participantes.
--
-- Roda numa transação desfeita no fim (nada fica no banco). Uso (banco local):
--   docker exec -i supabase_db_<projeto> psql -U postgres -X -v ON_ERROR_STOP=1 \
--     < supabase/tests/volume/e210_volume.psql > e210_explain.txt
-- A saída traz os planos (EXPLAIN ANALYZE e, dentro das RPCs, o auto_explain das consultas internas) e uma
-- linha "META" por medida, e uma "PLANO" por conferência de plano.

\set ON_ERROR_STOP on
\timing off
BEGIN;
SET LOCAL session_replication_role = replica;      -- carga: sem triggers
SET LOCAL synchronous_commit = off;

-- Pessoas (a árvore do volume do E2.02/E2.09): 2 pastores casados (1 e 2), 12 G12 (3 a 14) e 12
-- discípulos por pessoa até 20.000. 1 = pastor (Líder), 2 = Administrador, 3 = G12 (Líder).
INSERT INTO auth.users (id, email)
SELECT ('a2100900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid, 'e210-vol-' || n || '@teste.invalid' FROM generate_series(1, 3) n;

INSERT INTO public.members (id, name, gender, is_pastor, leader_id, spouse_id, is_active, has_leadership, auth_user_id, role_id, created_at, mobile_whatsapp)
SELECT ('c2100900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid,
       'Membro Volume ' || n,
       CASE WHEN n % 2 = 0 THEN 'F' ELSE 'M' END,
       n <= 2,
       CASE WHEN n <= 2 THEN NULL
            WHEN n <= 14 THEN ('c2100900-0000-0000-0000-' || lpad((1 + (n % 2))::text, 12, '0'))::uuid
            ELSE ('c2100900-0000-0000-0000-' || lpad((3 + (n - 15) / 12)::text, 12, '0'))::uuid END,
       CASE WHEN n <= 14 THEN ('c2100900-0000-0000-0000-' || lpad((CASE WHEN n % 2 = 1 THEN n + 1 ELSE n - 1 END)::text, 12, '0'))::uuid END,
       n % 10 <> 0,
       n > 2,
       CASE WHEN n <= 3 THEN ('a2100900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid END,
       CASE n WHEN 1 THEN (SELECT id FROM public.roles WHERE name = 'Líder')
              WHEN 2 THEN (SELECT id FROM public.roles WHERE name = 'Administrador')
              WHEN 3 THEN (SELECT id FROM public.roles WHERE name = 'Líder') END,
       now() - (n % 400) * interval '1 day',
       '519' || lpad(n::text, 8, '0')
  FROM generate_series(1, 20000) n;

-- 1.500 células (10% inativas), cadastradas ao longo de 750 dias, mais a célula 1.501 (400 relatórios).
INSERT INTO public.cells (id, leader_id, timothy_id, host_id, type, meeting_day, meeting_time, street, neighborhood, city, is_active, created_at)
SELECT ('d2100900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid,
       ('c2100900-0000-0000-0000-' || lpad((15 + (n * 13) % 19980)::text, 12, '0'))::uuid,
       ('c2100900-0000-0000-0000-' || lpad((15 + (n * 17) % 19980)::text, 12, '0'))::uuid,
       ('c2100900-0000-0000-0000-' || lpad((15 + (n * 19) % 19980)::text, 12, '0'))::uuid,
       (ARRAY['Evangelística', 'Discipulado', 'Macrocélula'])[1 + n % 3],
       (ARRAY['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'])[1 + n % 7],
       (ARRAY['19:00', '20:00', '23:30'])[1 + n % 3]::time,
       'Rua São João ' || n, 'Bairro ' || (n % 40), (ARRAY['Porto Alegre', 'Canoas', 'Alvorada'])[1 + n % 3],
       n % 10 <> 0,
       now() - (n % 750) * interval '1 day'
  FROM generate_series(1, 1501) n;

-- 100 mil relatórios em semanas passadas, com buracos (como no E2.09); nesta semana, metade tem.
INSERT INTO public.cell_reports (id, cell_id, date, time, was_held, theme, visitors, offering)
SELECT ('e2100900-0000-0000-0000-' || lpad(i::text, 12, '0'))::uuid,
       ('d2100900-0000-0000-0000-' || lpad((1 + i % 1500)::text, 12, '0'))::uuid,
       public.week_start(public.sp_today()) - 7 * (1 + i / 1500) + 3, '20:00', i % 7 <> 0, 'Tema ' || i,
       ARRAY['Visitante A', 'Visitante B'], 10
  FROM generate_series(0, 99999) i
 WHERE (i / 1500 + i % 1500) % 5 <> 0;
INSERT INTO public.cell_reports (id, cell_id, date, time, was_held, theme, offering)
SELECT ('e2100900-0000-0001-0000-' || lpad(n::text, 12, '0'))::uuid,
       ('d2100900-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid,
       public.week_start(public.sp_today()), '20:00', true, 'Semana atual', 10
  FROM generate_series(1, 1500, 2) n;
-- A célula com 400 relatórios (uma por semana, para trás).
INSERT INTO public.cell_reports (id, cell_id, date, time, was_held, theme, visitors, offering)
SELECT ('e2100900-0000-0002-0000-' || lpad(w::text, 12, '0'))::uuid,
       'd2100900-0000-0000-0000-000000001501'::uuid,
       public.week_start(public.sp_today()) - 7 * w + 3, '20:00', w % 9 <> 0, 'Tema ' || w,
       ARRAY['Visitante'], 10
  FROM generate_series(1, 400) w;
INSERT INTO public.cell_report_participants (report_id, member_id)
SELECT r.id, ('c2100900-0000-0000-0000-' || lpad((15 + ((row_number() OVER ()) * 7919 + k) % 19980)::text, 12, '0'))::uuid
  FROM public.cell_reports r, generate_series(0, 7) k
 WHERE r.id::text LIKE 'e2100900-0000-000_-%';
ANALYZE public.members; ANALYZE public.cells; ANALYZE public.cell_reports; ANALYZE public.cell_report_participants;
SET LOCAL session_replication_role = origin;
SELECT private.rebuild_member_hierarchy();
SELECT 'BACKFILL linhas criadas', private.backfill_cell_active_periods();
ANALYZE private.member_hierarchy; ANALYZE private.cell_active_periods;

SELECT 'VOLUME members=' || (SELECT count(*) FROM public.members WHERE deleted_at IS NULL)
    || ' cells=' || (SELECT count(*) FROM public.cells WHERE deleted_at IS NULL)
    || ' reports=' || (SELECT count(*) FROM public.cell_reports WHERE deleted_at IS NULL)
    || ' participants=' || (SELECT count(*) FROM public.cell_report_participants)
    || ' reports_cell_1501=' || (SELECT count(*) FROM public.cell_reports WHERE cell_id = 'd2100900-0000-0000-0000-000000001501') AS volume;

CREATE FUNCTION pg_temp.as_member(_n int) RETURNS void LANGUAGE sql AS $$
  SELECT set_config('request.jwt.claims', json_build_object('sub', 'a2100900-0000-0000-0000-' || lpad(_n::text, 12, '0'), 'role', 'authenticated')::text, true) $$;
-- Tempo de uma leitura, em ms: a mediana de _rounds execuções (depois de uma de aquecimento).
CREATE FUNCTION pg_temp.ms(_sql text, _rounds int DEFAULT 5) RETURNS numeric LANGUAGE plpgsql AS $$
DECLARE _t timestamptz; _xs numeric[] := '{}'; i int;
BEGIN
  EXECUTE _sql;
  FOR i IN 1.._rounds LOOP
    _t := clock_timestamp();
    EXECUTE _sql;
    _xs := _xs || (extract(epoch FROM clock_timestamp() - _t) * 1000)::numeric;
  END LOOP;
  RETURN round((SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY x) FROM unnest(_xs) x)::numeric, 1);
END $$;
CREATE FUNCTION pg_temp.plan_has(_sql text, _pat text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE _l text; _found boolean := false;
BEGIN
  FOR _l IN EXECUTE 'EXPLAIN (VERBOSE) ' || _sql LOOP
    IF _l LIKE '%' || _pat || '%' THEN _found := true; END IF;
  END LOOP;
  RETURN _found;
END $$;
-- Em que nó do plano aparece um texto: o nome do nó mais próximo acima da linha que o tem.
CREATE FUNCTION pg_temp.plan_node(_sql text, _pat text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE _l text; _node text := '';
BEGIN
  FOR _l IN EXECUTE 'EXPLAIN (VERBOSE) ' || _sql LOOP
    IF _l ~ '->|^\S' THEN _node := btrim(regexp_replace(split_part(_l, '  (cost', 1), '^\s*->\s*', '')); END IF;
    IF _l LIKE '%' || _pat || '%' AND _l !~ '->|^\S' THEN RETURN _node; END IF;
  END LOOP;
  RETURN NULL;
END $$;
CREATE FUNCTION pg_temp.show(_sql text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('client_min_messages', 'log', true);
  EXECUTE _sql;
  PERFORM set_config('client_min_messages', 'notice', true);
END $$;

SELECT 'd2100900-0000-0000-0000-000000001501' AS big_cell \gset
SELECT 'd2100900-0000-0000-0000-000000000007' AS any_cell \gset
SELECT id AS g12_id FROM private.member_hierarchy h JOIN public.members m ON m.id = h.member_id
 WHERE h.g12_level = 1 ORDER BY m.id LIMIT 1 \gset
SELECT array_agg(DISTINCT leader_id)::text AS ten_leaders FROM (SELECT leader_id FROM public.cells WHERE id::text LIKE 'd2100900%' ORDER BY id LIMIT 10) x \gset
\set cell_cols 'id, leader_id, timothy_id, host_id, type, meeting_day, meeting_time, street, number, complement, neighborhood, city, state, zip_code, is_active, created_at, leader_name, leader_g12_level, timothy_name, host_name, g12_leader_id, g12_leader_name, can_submit_report, is_mine, leader_is_pastor, report_status, report_missing_weeks, created_by_kind, created_by_name, updated_by_kind, updated_by_name, updated_at'
\set combo '_search => \'{%sao%}\', _g12_ids => ARRAY[\'':g12_id'\']::uuid[], _street => \'rua\', _city => \'porto\', _types => \'{Evangelística,Discipulado}\', _weekdays => \'{1,2,3,4,5}\', _is_active => true, _report_statuses => \'{pending,not_yet}\', _missing_weeks => \'{1,2}\', _created_from => (public.sp_today() - 500), _created_to => public.sp_today()'

SET auto_explain.log_min_duration = -1;

\echo
\echo '######## Planos das consultas internas das RPCs (auto_explain), Administrador ########'
SET auto_explain.log_min_duration = 2;   -- só as consultas que custam (as internas das RPCs)
SET auto_explain.log_analyze = on;
SET auto_explain.log_buffers = on;
SET auto_explain.log_nested_statements = on;
SELECT pg_temp.as_member(2);
SET LOCAL ROLE authenticated;
\echo '--- cells_list e cells_list_count sem filtros'
SELECT pg_temp.show('SELECT id FROM public.cells_list()');
SELECT pg_temp.show('SELECT public.cells_list_count()');
\echo '--- só Pendente'
SELECT pg_temp.show($$SELECT public.cells_list_count(_report_statuses => '{pending}')$$);
\echo '--- a combinação da RN-02'
SELECT format('SELECT pg_temp.show(%L)', format('SELECT public.cells_list_count(%s)', :'combo')) \gexec
\echo '--- cell_recent_reports na célula com 400 relatórios'
SELECT format('SELECT pg_temp.show(%L)', format('SELECT * FROM public.cell_recent_reports(%L)', :'big_cell')) \gexec
RESET ROLE;
SET auto_explain.log_min_duration = -1;
SET auto_explain.log_nested_statements = off;

\echo
\echo '######## Conferências de plano (Administrador) ########'
SELECT pg_temp.as_member(2);
SET LOCAL ROLE authenticated;
SELECT 'PLANO etapa 2 (id = ANY): usa cells_pkey? (esperado t)' AS plano,
  pg_temp.plan_has(format('SELECT v.* FROM public.cells_view v WHERE v.id = ANY (ARRAY[%L, %L]::uuid[])', :'any_cell', :'big_cell'), 'cells_pkey') AS sim;
SELECT 'PLANO contagem sem filtro de situação: chama cell_report_situation? (esperado f)' AS plano,
  pg_temp.plan_has('SELECT count(*) FROM public.cells_view v WHERE true AND v.is_active = true AND v.type = ANY (''{Discipulado}'')', 'cell_report_situation') AS sim;
SELECT 'PLANO contagem com Pendente: chama cell_report_situation? (esperado t)' AS plano,
  pg_temp.plan_has($$SELECT count(*) FROM public.cells_view v WHERE (v.report_status = ANY ('{pending}') OR v.report_missing_weeks = ANY ('{}'))$$, 'cell_report_situation') AS sim;
SELECT 'PLANO G12 entra na view: o filtro fica abaixo do Subquery Scan? (nó)' AS plano,
  pg_temp.plan_node(format('SELECT v.id FROM public.cells_view v WHERE v.g12_leader_id = ANY (ARRAY[%L]::uuid[])', :'g12_id'), 'g12_id = ANY') AS no;
SELECT 'PLANO data entra na view: o filtro fica abaixo do Subquery Scan? (nó)' AS plano,
  pg_temp.plan_node($$SELECT v.id FROM public.cells_view v WHERE v.created_at >= now() - interval '30 days'$$, 'created_at >=') AS no;
-- Um dos dois índices que começam por cell_id (o planejador escolhe; os dois servem).
SELECT 'PLANO cell_recent_reports: índice por cell_id (cell_reports_cell_id_date_idx ou cell_reports_cell_week_key)? (esperado t)' AS plano,
  pg_temp.plan_has(format('SELECT r.id, r.participants_count FROM public.cell_reports_view r WHERE r.cell_id = %L', :'big_cell'), 'cell_reports_cell_id_date_idx')
  OR pg_temp.plan_has(format('SELECT r.id, r.participants_count FROM public.cell_reports_view r WHERE r.cell_id = %L', :'big_cell'), 'cell_reports_cell_week_key') AS sim;
SELECT 'PLANO cell_recent_reports: cell_report_participants_pkey? (esperado t)' AS plano,
  pg_temp.plan_has(format('SELECT r.id, r.participants_count FROM public.cell_reports_view r WHERE r.cell_id = %L', :'big_cell'), 'cell_report_participants_pkey') AS sim;
EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM public.cells_list();
EXPLAIN (ANALYZE, BUFFERS) SELECT public.cells_list_count();
SELECT format('EXPLAIN (ANALYZE, BUFFERS) SELECT %s FROM public.cells_view WHERE id = %L', :'cell_cols', :'big_cell') \gexec
SELECT format('EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM public.cell_recent_reports(%L)', :'big_cell') \gexec
RESET ROLE;

\echo
\echo '######## Medidas: Administrador (igreja toda) ########'
SELECT pg_temp.as_member(2);
SET LOCAL ROLE authenticated;
SELECT 'META Administrador: cells_list sem filtros (ms, meta 150)', pg_temp.ms('SELECT * FROM public.cells_list()') AS ms;
SELECT 'META Administrador: cells_list_count sem filtros (ms, meta 150)', pg_temp.ms('SELECT public.cells_list_count()') AS ms,
  (SELECT public.cells_list_count()) AS total;
SELECT 'META Administrador: cells_list só Pendente (ms, meta 300)', pg_temp.ms($$SELECT * FROM public.cells_list(_report_statuses => '{pending}')$$) AS ms;
SELECT 'META Administrador: cells_list_count só Pendente (ms, meta 300)', pg_temp.ms($$SELECT public.cells_list_count(_report_statuses => '{pending}')$$) AS ms,
  (SELECT public.cells_list_count(_report_statuses => '{pending}')) AS total;
SELECT format($q$SELECT 'META Administrador: cells_list combinação RN-02 (ms, meta 1000)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cells_list(%s)', :'combo')) \gexec
SELECT format($q$SELECT 'META Administrador: cells_list_count combinação RN-02 (ms, meta 1000)', pg_temp.ms(%L) AS ms, (SELECT public.cells_list_count(%s)) AS total$q$,
              format('SELECT public.cells_list_count(%s)', :'combo'), :'combo') \gexec
SELECT 'META Administrador: cells_list última página (offset 1475) (ms)', pg_temp.ms('SELECT * FROM public.cells_list(_offset => 1475)') AS ms;
SELECT 'META Administrador: cell_filter_options Líder (ms, meta 100)', pg_temp.ms($$SELECT * FROM public.cell_filter_options('leader')$$) AS ms;
SELECT 'META Administrador: cell_filter_options Líder com busca (ms, meta 100)', pg_temp.ms($$SELECT * FROM public.cell_filter_options('leader', '{%volume 1%}')$$) AS ms;
SELECT 'META Administrador: cell_filter_options G12 (ms, meta 100)', pg_temp.ms($$SELECT * FROM public.cell_filter_options('g12')$$) AS ms;
SELECT 'META Administrador: cell_filter_options G12 com busca (ms, meta 100)', pg_temp.ms($$SELECT * FROM public.cell_filter_options('g12', '{%volume 1%}')$$) AS ms;
SELECT format($q$SELECT 'META Administrador: cell_filter_names 10 ids, Líder (ms, meta 50)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cell_filter_names(''leader'', %L::uuid[])', :'ten_leaders')) \gexec
SELECT format($q$SELECT 'META Administrador: cell_filter_names 10 ids, G12 (ms, meta 50)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cell_filter_names(''g12'', %L::uuid[])', :'ten_leaders')) \gexec
SELECT format($q$SELECT 'META Administrador: cells_view por id, colunas do detalhe (ms, meta 100)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT %s FROM public.cells_view WHERE id = %L', :'cell_cols', :'big_cell')) \gexec
SELECT format($q$SELECT 'META Administrador: cell_recent_reports, 400 relatórios (ms, meta 150)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cell_recent_reports(%L)', :'big_cell')) \gexec
SELECT format($q$SELECT 'META Administrador: cell_identity (ms, meta 50)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cell_identity(%L)', :'big_cell')) \gexec
SELECT format($q$SELECT 'META Administrador: cell_reports_view por cell_id, página + total (ms, meta 150)', pg_temp.ms(%L) + pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cell_reports_view WHERE cell_id = %L ORDER BY date DESC, id LIMIT 25', :'big_cell'),
              format('SELECT count(*) FROM public.cell_reports_view WHERE cell_id = %L', :'big_cell')) \gexec
RESET ROLE;

\echo
\echo '######## Medidas: G12 (Líder, o próprio ministério) ########'
SELECT pg_temp.as_member(3);
SET LOCAL ROLE authenticated;
SELECT 'CONFERÊNCIA G12: células visíveis', count(*) FROM public.cells_view;
SELECT 'META G12: cells_list sem filtros (ms, meta 100)', pg_temp.ms('SELECT * FROM public.cells_list()') AS ms;
SELECT 'META G12: cells_list_count sem filtros (ms, meta 100)', pg_temp.ms('SELECT public.cells_list_count()') AS ms;
SELECT 'META G12: cells_list_count só Pendente (ms)', pg_temp.ms($$SELECT public.cells_list_count(_report_statuses => '{pending}')$$) AS ms;
SELECT 'META G12: cell_filter_options Líder (ms)', pg_temp.ms($$SELECT * FROM public.cell_filter_options('leader')$$) AS ms;
SELECT format($q$SELECT 'META G12: cell_recent_reports, 400 relatórios (ms)', pg_temp.ms(%L) AS ms$q$,
              format('SELECT * FROM public.cell_recent_reports(%L)', :'big_cell')) \gexec
RESET ROLE;

ROLLBACK;
