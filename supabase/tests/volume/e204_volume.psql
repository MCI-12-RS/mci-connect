-- E2.04 (PR 1): volume de referência de member_descendants_among (risco 11).
-- Spec: docs/specs/e2-04-validacoes-membro.md, Riscos, item 11: 20 mil membros, profundidade de
-- até 10; member_descendants_among com 21 ids abaixo de 20 ms.
--
-- Árvore: 2 pastores (1 e 2); membros 3 a 2047 num heap binário (profundidade até 10, com 1 como
-- raiz); os demais, até 20.000, sob membros de profundidade 9 (profundidade 10). Um usuário
-- Administrador (membro 1, vê a igreja toda) e um Líder G12 (membro 3, vê só o ministério).
--
-- Roda numa transação desfeita no fim (nada fica no banco). Uso (banco local):
--   docker exec -i supabase_db_<projeto> psql -U postgres -X -v ON_ERROR_STOP=1 \
--     < supabase/tests/volume/e204_volume.psql > e204_explain.txt
-- A saída traz o EXPLAIN (ANALYZE, BUFFERS) e uma linha "META" por medida, com o tempo e o limite.

\set ON_ERROR_STOP on
\timing off
BEGIN;
SET LOCAL session_replication_role = replica;      -- carga: sem triggers (níveis explícitos)
SET LOCAL synchronous_commit = off;

INSERT INTO auth.users (id, email)
SELECT ('a2041400-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid, 'e204-vol-' || n || '@teste.invalid' FROM generate_series(1, 3) n;

INSERT INTO public.members (id, name, gender, is_pastor, leader_id, g12_level, is_active, has_leadership, auth_user_id, role_id, created_at, mobile_whatsapp)
SELECT ('c2041400-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid,
       'Membro Volume ' || n,
       CASE WHEN n % 2 = 0 THEN 'F' ELSE 'M' END,
       n <= 2,
       CASE WHEN n <= 2 THEN NULL
            WHEN n <= 2047 THEN ('c2041400-0000-0000-0000-' || lpad((n / 2)::text, 12, '0'))::uuid
            ELSE ('c2041400-0000-0000-0000-' || lpad((512 + (n::bigint * 7919) % 512)::text, 12, '0'))::uuid END,
       CASE WHEN n <= 2 THEN 0 ELSE 1 END,
       n % 10 <> 0,
       n > 2,
       CASE n WHEN 1 THEN 'a2041400-0000-0000-0000-000000000001'::uuid
              WHEN 3 THEN 'a2041400-0000-0000-0000-000000000003'::uuid END,
       CASE WHEN n = 1 THEN (SELECT id FROM public.roles WHERE name = 'Administrador')
            WHEN n = 3 THEN (SELECT id FROM public.roles WHERE name = 'Líder') END,
       now() - (n % 400) * interval '1 day',
       '519' || lpad(n::text, 8, '0')                -- E2.04: identificador real e único (RN-08, RN-09)
  FROM generate_series(1, 20000) n;
ANALYZE public.members;
SET LOCAL session_replication_role = origin;

SELECT 'VOLUME members=' || count(*) || ' ids distintos de líder=' || count(DISTINCT leader_id) AS volume FROM public.members;
-- Profundidade máxima (conferência da massa).
WITH RECURSIVE t(id, d) AS (SELECT id, 0 FROM public.members WHERE leader_id IS NULL
                            UNION ALL SELECT m.id, t.d + 1 FROM t JOIN public.members m ON m.leader_id = t.id)
SELECT 'PROFUNDIDADE max=' || max(d) AS depth FROM t;

-- 21 candidatos: os 21 membros mais fundos (profundidade 10, no fim da árvore) e o membro
-- consultado é o pastor 1 (todos descendem dele) ou o G12 3 (alguns descendem, outros não).
SELECT array_to_string(array_agg(quote_literal(('c2041400-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid)), ',') AS cands_deep
  FROM generate_series(19980, 20000) n \gset
SELECT array_to_string(array_agg(quote_literal(('c2041400-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid)), ',') AS cands_mixed
  FROM generate_series(3000, 3020) n \gset
SELECT quote_literal('c2041400-0000-0000-0000-000000000001') AS p1, quote_literal('c2041400-0000-0000-0000-000000000003') AS p3 \gset

-- Tempo de uma consulta, em ms (o melhor de _rounds).
CREATE FUNCTION pg_temp.ms(_sql text, _rounds int DEFAULT 7) RETURNS numeric LANGUAGE plpgsql AS $$
DECLARE _t timestamptz; _best numeric := NULL; _x numeric; i int;
BEGIN
  FOR i IN 1.._rounds LOOP
    _t := clock_timestamp();
    EXECUTE _sql;
    _x := extract(epoch FROM clock_timestamp() - _t) * 1000;
    IF _best IS NULL OR _x < _best THEN _best := _x; END IF;
  END LOOP;
  RETURN round(_best, 2);
END $$;

\echo
\echo '######## Administrador (membro 1, vê a igreja toda), 21 candidatos no fim da árvore ########'
SELECT set_config('request.jwt.claims', '{"sub":"a2041400-0000-0000-0000-000000000001","role":"authenticated"}', true);
SET LOCAL ROLE authenticated;
EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM public.member_descendants_among(:p1::uuid, ARRAY[:cands_deep]::uuid[]);
SELECT 'META admin: 21 ids no fim da árvore (ms, meta 20)', pg_temp.ms(format('SELECT * FROM public.member_descendants_among(%s::uuid, ARRAY[%s]::uuid[])', :'p1', :'cands_deep')) AS ms;
SELECT 'META admin: 21 ids misturados (ms, meta 20)', pg_temp.ms(format('SELECT * FROM public.member_descendants_among(%s::uuid, ARRAY[%s]::uuid[])', :'p1', :'cands_mixed')) AS ms;
SELECT 'RESULTADO admin: ids devolvidos (profundos)', count(*) FROM public.member_descendants_among(:p1::uuid, ARRAY[:cands_deep]::uuid[]);
RESET ROLE;

\echo
\echo '######## G12 (membro 3, vê só o ministério), 21 candidatos ########'
SELECT set_config('request.jwt.claims', '{"sub":"a2041400-0000-0000-0000-000000000003","role":"authenticated"}', true);
SET LOCAL ROLE authenticated;
EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM public.member_descendants_among(:p3::uuid, ARRAY[:cands_deep]::uuid[]);
SELECT 'META G12: 21 ids no fim da árvore (ms, meta 20)', pg_temp.ms(format('SELECT * FROM public.member_descendants_among(%s::uuid, ARRAY[%s]::uuid[])', :'p3', :'cands_deep')) AS ms;
SELECT 'META G12: 21 ids misturados (ms, meta 20)', pg_temp.ms(format('SELECT * FROM public.member_descendants_among(%s::uuid, ARRAY[%s]::uuid[])', :'p3', :'cands_mixed')) AS ms;
SELECT 'RESULTADO G12: ids devolvidos (profundos)', count(*) FROM public.member_descendants_among(:p3::uuid, ARRAY[:cands_deep]::uuid[]);
RESET ROLE;

ROLLBACK;
